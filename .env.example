# ==============================================================================
# GelombangMaya Community Edition (CE) - Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI
DATABASE_URL="mysql://gelombangmaya:secretpassword@localhost:3306/gelombangmaya_db"

# Option B: Individual Connection Parameters (used if DATABASE_URL is not provided)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="gelombangmaya"
DB_PASSWORD="secretpassword"
DB_NAME="gelombangmaya_db"
